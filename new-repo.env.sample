# new-repo.env — the three 1Password references new-repo.sh reads to set a new
# repository's `default-branch` environment secrets (and the repo-level
# MARGOT_APP_KEY). Install at ${XDG_CONFIG_HOME:-$HOME/.config}/estate/new-repo.env
# (or point NEW_REPO_SECRETS_ENV at it). Values are `op://` REFERENCES, never the
# secrets themselves: the script resolves each with `op read` at the moment it
# sets the secret, and never echoes, logs or writes the resolved value.
#
# Copy this file, replace every placeholder with the real reference from the
# vault that holds the estate's App keys and operator ruleset. An empty or
# unreadable reference is fatal BEFORE any secret is set.
OPERATOR_RULES_REF="op://YOUR_VAULT/YOUR_OPERATOR_RULES_ITEM/YOUR_FIELD"
MARGOT_APP_KEY_REF="op://YOUR_VAULT/YOUR_MARGOT_APP_KEY_ITEM/YOUR_FIELD"
OLLIE_APP_KEY_REF="op://YOUR_VAULT/YOUR_OLLIE_APP_KEY_ITEM/YOUR_FIELD"
