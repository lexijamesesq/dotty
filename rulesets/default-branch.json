  "branch_rulesets": [
    {
      "name": "Protect main — review",
      "description": "One required approving review on main (required_approving_review_count: 1, dismiss_stale_reviews_on_push). Margot's native APPROVE clears LOW/mechanical; the operator's Approve clears MED/HIGH. Every non-approve verdict is a COMMENT that informs but never blocks, so the operator's approval always satisfies the gate with nothing to dismiss. Bypass = the admin RepositoryRole (5) ONLY — Ollie is deliberately NOT a bypass here, so Ollie's merge is subject to the review and can only land an APPROVED PR. require_code_owner_review is retired: CODEOWNERS is no longer the merge authority, Margot's ranking is (backed by the mechanical floor).",
      "rules": [
        "pull_request"
      ],
      "bypass_actors": [
        {
          "actor_type": "RepositoryRole",
          "actor_id": 5,
          "bypass_mode": "pull_request"
        }
      ]
    },
    {
      "name": "Protect main — updates",
      "description": "The wall: only a designated merger may UPDATE main. Bypass = Ollie (4984137), the sole merger App, and the admin RepositoryRole (5) — both at pull_request mode (merge via PR, no standing direct-push bypass, per the estate's no-'always'-bypass invariant; a genuine emergency uses GitHub's admin override, not a persistent hole). Every other identity — the agent App, Renovate, any collaborator — cannot update main, so an approved PR merges only through Ollie. This is what makes reviewer-can't-merge and agent-can't-merge structural (the wall), not a matter of scope: Margot holds contents:write so its approval counts, and is kept from merging by being absent from THIS ruleset's bypass.",
      "rules": [
        "update"
      ],
      "bypass_actors": [
        {
          "actor_type": "Integration",
          "actor_id": 4984137,
          "bypass_mode": "pull_request"
        },
        {
          "actor_type": "RepositoryRole",
          "actor_id": 5,
          "bypass_mode": "pull_request"
        }
      ]
    },
    {
      "name": "Protect main — checks",
      "description": "The mechanical floor: required status checks and the two rules that stop history being rewritten (non_fast_forward, deletion). ADMIN ONLY may bypass — Ollie never bypasses the floor, so every Ollie merge inherits a green CI. strict_required_status_checks_policy (up-to-date-before-merge) is OFF: an approved PR merges without a forced rebase, so a rebase-push can't dismiss the approval that just cleared the gate; the required checks themselves still gate every merge. Kept separate from the review ruleset so a bypass actor on review stays fully subject to the floor.",
      "rules": [
        "required_status_checks",
        "non_fast_forward",
        "deletion"
      ],
      "bypass_actors": [
        {
          "actor_type": "RepositoryRole",
          "actor_id": 5,
          "bypass_mode": "pull_request"
        }
      ]
    }
  ]
}
