{
  "pull_request": {
    "required_approving_review_count": 0,
    "dismiss_stale_reviews_on_push": true,
    "require_code_owner_review": true,
    "require_last_push_approval": false,
    "required_review_thread_resolution": false,
    "require_extra_approval_for_unattributed_changes": true
  },
  "required_status_checks": {
    "strict_required_status_checks_policy": true
  },
  "tag_ruleset": {
    "name": "Tag immutability",
    "rules": [
      "update",
      "deletion"
    ]
  },
  "repos": {
    "lexijamesesq/hazel": {
      "private_repo": true,
      "required_contexts": [
        "all-checks-passed",
        "trusted-scan / trusted-scan"
      ],
      "codeowners_appendix": [
        "/README.md",
        "/LICENSE",
        "/DEPLOYMENT.md",
        "/HARDENING.md"
      ]
    },
    "lexijamesesq/dotty-private": {
      "private_repo": true,
      "required_contexts": [
        "all-checks-passed",
        "trusted-scan / trusted-scan",
        "eval-suite"
      ],
      "codeowners_appendix": []
    },
    "lexijamesesq/susuwatari-config": {
      "private_repo": true,
      "required_contexts": [
        "all-checks-passed",
        "trusted-scan / trusted-scan"
      ],
      "codeowners_appendix": [
        "/README.md",
        "/docs/**/*.md"
      ]
    },
    "lexijamesesq/core-skills": {
      "required_contexts": [
        "all-checks-passed",
        "trusted-scan / trusted-scan",
        "release-check"
      ],
      "codeowners_appendix": [
        "/README.md",
        "/LICENSE",
        "/DEV_LOOP.md"
      ]
    },
    "lexijamesesq/metrics": {
      "required_contexts": [
        "all-checks-passed",
        "trusted-scan / trusted-scan"
      ],
      "codeowners_appendix": [
        "/README.md",
        "/LICENSE",
        "/Infrastructure/**/*.md",
        "/NPS/**/*.md",
        "/UX\\ Bugs/**/*.md",
        "/Usage/**/*.md"
      ]
    },
    "lexijamesesq/probe-local-to-merged": {
      "private_repo": true,
      "required_contexts": [
        "all-checks-passed",
        "trusted-scan / trusted-scan"
      ]
    },
    "lexijamesesq/dotty": {
      "required_contexts": [
        "all-checks-passed",
        "trusted-scan / trusted-scan",
        "eval-suite"
      ],
      "codeowners_appendix": [
        "/README.md",
        "/LICENSE"
      ]
    },
    "lexijamesesq/home-assistant-tools": {
      "required_contexts": [
        "all-checks-passed",
        "trusted-scan / trusted-scan"
      ],
      "codeowners_appendix": [
        "/README.md",
        "/LICENSE"
      ]
    },
    "lexijamesesq/incubator": {
      "required_contexts": [
        "all-checks-passed",
        "trusted-scan / trusted-scan"
      ],
      "codeowners_appendix": [
        "/README.md",
        "/LICENSE",
        "/Ideas/**/*.md",
        "/Examples/**/*.md",
        "/reference/**/*.md",
        "/incubator-reference.md"
      ]
    },
    "lexijamesesq/publish-skills": {
      "required_contexts": [
        "all-checks-passed",
        "trusted-scan / trusted-scan",
        "release-check"
      ],
      "codeowners_appendix": [
        "/README.md",
        "/LICENSE"
      ]
    },
    "lexijamesesq/wiki": {
      "required_contexts": [
        "all-checks-passed",
        "trusted-scan / trusted-scan"
      ],
      "codeowners_appendix": [
        "/README.md",
        "/LICENSE"
      ]
    },
    "lexijamesesq/personal-skills": {
      "required_contexts": [
        "all-checks-passed",
        "trusted-scan / trusted-scan",
        "release-check"
      ],
      "codeowners_appendix": [
        "/README.md",
        "/LICENSE"
      ]
    },
    "lexijamesesq/system-skills": {
      "required_contexts": [
        "all-checks-passed",
        "trusted-scan / trusted-scan",
        "release-check"
      ],
      "codeowners_appendix": [
        "/README.md",
        "/LICENSE"
      ]
    },
    "lexijamesesq/home-assistant": {
      "required_contexts": [
        "all-checks-passed",
        "trusted-scan / trusted-scan",
        "secret-scan"
      ],
      "codeowners_appendix": [
        "/README.md"
      ]
    }
  },
  "codeowners_default_owner": "@lexijamesesq",
  "release_tag_authors": [
    "claude-the-enduring[bot]",
    "github-actions[bot]"
  ]
}
