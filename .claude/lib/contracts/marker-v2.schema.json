{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://<user>.github.io/dotty/schemas/marker-v3.schema.json",
  "title": "github-prep marker v3",
  "description": "Structured verdict marker written by /github-prep and consumed by /github-push. v3 adds scope_files (the file list prep actually scanned) so push can refuse when the actual push surface contains files prep did not see.",
  "type": "object",
  "required": [
    "marker_schema_version",
    "evaluated_path",
    "evaluated_at",
    "scope",
    "scope_files",
    "scanner_version",
    "policy_hash",
    "verdict",
    "findings",
    "acknowledgments",
    "summary"
  ],
  "properties": {
    "marker_schema_version": {
      "type": "integer",
      "const": 3,
      "description": "Hard schema version. /github-push refuses on mismatch with re-prep guidance. v3 adds required scope_files."
    },
    "evaluated_path": {
      "type": "string",
      "minLength": 1,
      "description": "Absolute path to the evaluated artifact (project root or specific artifact)."
    },
    "evaluated_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "description": "ISO 8601 UTC timestamp of this evaluation."
    },
    "scope": {
      "type": "string",
      "enum": ["change-set", "full-audit", "docs-only"],
      "description": "Scope determined for this scan."
    },
    "scope_files": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "description": "The exact list of file paths (relative to repo root) prep actually scanned. /github-push reads this and refuses if the actual push surface (commits-ahead-of-baseline ∪ staged) contains any file not in this list. Empty array means nothing was scanned (e.g., change-set scope with no staged changes)."
    },
    "last_full_scan_at": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        }
      ],
      "description": "Timestamp of the most recent full-audit scan. Null on first run. Drives TTL-driven auto-upgrade."
    },
    "scope_upgrade_reason": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "minLength": 1}
      ],
      "description": "Human-readable explanation if the actual scope differs from the requested scope."
    },
    "files_scanned_count": {
      "type": "integer",
      "minimum": 0
    },
    "scanner_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "Semver. Bumped on taxonomy / persona / pre-pass pattern changes. Mismatch invalidates cache."
    },
    "policy_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "SHA-256 of the per-project github-policy.yaml. Mismatch invalidates verdict."
    },
    "persona_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "SHA-256 of the github-prep agent persona file content at marker write. Cache-check mismatch invalidates cache."
    },
    "verdict": {
      "type": "string",
      "enum": ["allow", "block", "revise", "escalate"],
      "description": "Overall verdict by precedence (any Escalate → escalate; any Revise → revise; any Block → block; else allow)."
    },
    "artifact_type": {
      "type": "string",
      "enum": ["project", "skill", "agent", "rule", "claude-config"]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["category", "verdict", "file", "line", "snippet", "reason"],
        "properties": {
          "category": {
            "type": "string",
            "enum": [
              "Secret",
              "PII",
              "Hardcoded path",
              "Internal reference",
              "Personal context",
              "Domain knowledge",
              "Separation of concerns",
              "Sample drift"
            ]
          },
          "verdict": {
            "type": "string",
            "enum": ["Allow", "Block", "Revise", "Escalate"]
          },
          "file": {
            "type": "string",
            "minLength": 1
          },
          "line": {
            "type": "integer",
            "minimum": 0
          },
          "snippet": {
            "type": "string"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "enum": ["prepass", "judgment", "sample-drift", "docs-check", "baseline"]
          },
          "baselined": {
            "type": "boolean"
          },
          "baselined_from_verdict": {
            "type": "string",
            "enum": ["Allow", "Block", "Revise", "Escalate"]
          }
        },
        "additionalProperties": false
      }
    },
    "acknowledgments": {
      "type": "array",
      "description": "Per-finding acks recorded by /github-push at the action boundary. Keyed by finding index + hash. Only Block findings are ack-able.",
      "items": {
        "type": "object",
        "required": ["finding_index", "finding_hash", "acknowledged_at", "ack_string"],
        "properties": {
          "finding_index": {"type": "integer", "minimum": 0},
          "finding_hash": {"type": "string"},
          "acknowledged_at": {"type": "string", "format": "date-time"},
          "ack_string": {"type": "string"},
          "operator_reason": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "file_hashes": {
      "type": "object",
      "description": "Per-file content SHA-256 for incremental scan on re-run.",
      "additionalProperties": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      }
    },
    "summary": {
      "type": "object",
      "required": ["allow", "block", "revise", "escalate"],
      "properties": {
        "allow": {"type": "integer", "minimum": 0},
        "block": {"type": "integer", "minimum": 0},
        "revise": {"type": "integer", "minimum": 0},
        "escalate": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
