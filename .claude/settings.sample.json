{
  "_comment": "Sample settings.json for public consumers of dotty's hooks and statusline. Real settings.json lives in dotty-private (gitignored from public surface). Copy the blocks you want into your own settings.json. TODO: adjust paths to match your dotty checkout location, and set VAULT_ROOT to your Obsidian vault (the vault-aware hooks fail-open and silently disable themselves without it).",
  "env": {
    "VAULT_ROOT": "path/to/your/obsidian-vault"
  },
  "permissions": {
    "allow": [
      "Task",
      "WebFetch",
      "WebSearch"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/bin/dotty/.claude/statusline/statusline.sh"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "~/bin/dotty/.claude/hooks/fix-obsidian-claude-sync.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "~/bin/dotty/.claude/hooks/profile-symlink-guard.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "~/bin/dotty/.claude/hooks/session-init.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "resume",
        "hooks": [
          {
            "type": "command",
            "command": "~/bin/dotty/.claude/hooks/session-init.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read|Grep|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "~/bin/dotty/.claude/hooks/vault-mcp-redirect.sh",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
