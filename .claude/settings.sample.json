{
  "_comment": "Sample settings.json for public consumers of dotty's hooks. Real settings.json lives in dotty-private (gitignored from public surface). Copy this file's hooks block into your own settings.json to wire up fix-obsidian-claude-sync (Obsidian users only), vault-mcp-redirect, and git-gate. Adjust paths to match your dotty checkout location.",
  "permissions": {
    "allow": [
      "Task",
      "WebFetch",
      "WebSearch"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "~/bin/dotty/.claude/hooks/fix-obsidian-claude-sync.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "~/bin/dotty/.claude/hooks/session-init.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "resume",
        "hooks": [
          {
            "type": "command",
            "command": "~/bin/dotty/.claude/hooks/session-init.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read|Grep|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "~/bin/dotty/.claude/hooks/vault-mcp-redirect.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/bin/dotty/.claude/hooks/git-gate.sh",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
