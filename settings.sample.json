{
  "permissions": {
    "allow": [
      "Task",
      "WebFetch",
      "WebSearch"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "PATH_TO_DOTTY/claude-statusline.sh"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "PATH_TO_DOTTY/.claude/hooks/fix-obsidian-claude-sync.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "PATH_TO_DOTTY/.claude/hooks/session-init.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "resume",
        "hooks": [
          {
            "type": "command",
            "command": "PATH_TO_DOTTY/.claude/hooks/session-init.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read|Grep|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "PATH_TO_DOTTY/.claude/hooks/vault-mcp-redirect.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "PATH_TO_DOTTY/.claude/hooks/git-gate.sh",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
